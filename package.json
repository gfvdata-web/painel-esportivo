{
  "name": "painel-esportivo",
  "private": true,
  "version": "0.1.0",
  "description": "Painel pessoal com o histórico esportivo do Strava e do Samsung Health.",
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "ingest": "tsx src/ingest/index.ts",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@garmin/fitsdk": "^21.217.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.3",
    "csv-parse": "^7.0.3",
    "fast-xml-parser": "^5.11.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
